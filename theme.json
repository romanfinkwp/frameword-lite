{
  "version": 2,
  "customTemplates": [
    {
      "name": "page-with-header",
      "title": "Page with header"
    }
  ],
  "templateParts": [
    {
      "name": "header",
      "title": "Header",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Footer",
      "area": "footer"
    }
  ],
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "1240px",
      "wideSize": "1440px"
    },
    "custom": {
      "typography": {
        "line-height": {
          "normal": 1.35
        }
      }
    },
    "spacing": {
      "blockGap": true,
      "margin": true,
      "padding": true,
      "units": [
        "px",
        "em",
        "rem",
        "vh",
        "vw",
        "%"
      ],
      "spacingSizes": [
        {
          "name": "XXS",
          "size": "8px",
          "slug": "xxs"
        },
        {
          "name": "XS",
          "size": "clamp(8px, 3vw, 16px)",
          "slug": "xs"
        },
        {
          "name": "SM",
          "size": "clamp(16px, 4vw, 24px)",
          "slug": "sm"
        },
        {
          "name": "MD",
          "size": "32px",
          "slug": "md"
        },
        {
          "name": "LG",
          "size": "clamp(28px, 7vw, 40px)",
          "slug": "lg"
        },
        {
          "name": "XL",
          "size": "clamp(40px, 7.5vw, 64px)",
          "slug": "xl"
        },
        {
          "name": "2XL",
          "size": "clamp(64px, 9vw, 88px)",
          "slug": "2xl"
        },
        {
          "name": "3XL",
          "size": "clamp(88px, 12vw, 112px)",
          "slug": "3xl"
        }
      ]
    },
    "border": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "defaultDuotone": false,
      "duotone": [
				{
					"colors": ["#111111", "#ffffff"],
					"slug": "duotone-1",
					"name": "Default"
				},
        {
					"colors": ["#fff", "#111"],
					"slug": "duotone-reverse",
					"name": "Revers"
				}
      ],
      "palette": [
        {
          "slug": "accent",
          "color": "#111111",
          "name": "Accent"
        },
        {
          "slug": "font",
          "color": "#111111",
          "name": "Font"
        },
        {
          "slug": "font-headers",
          "color": "#111111",
          "name": "Font Headers"
        },
        {
          "slug": "font-text",
          "color": "#888",
          "name": "Font Text"
        },
        {
          "slug": "font-light",
          "color": "#fff",
          "name": "Font Light"
        },
        {
          "slug": "font-headers-light",
          "color": "#fff",
          "name": "Font Headers Light"
        },
        {
          "slug": "font-text-light",
          "color": "#888",
          "name": "Font Text Light"
        },
        {
          "slug": "header-background",
          "color": "#ffffff",
          "name": "Header Background"
        },
        {
          "slug": "header-font",
          "color": "#111",
          "name": "Header Font"
        },
        {
          "slug": "background",
          "color": "#ffffff",
          "name": "Background"
        },
        {
          "slug": "background-soft",
          "color": "#eee",
          "name": "Background Soft"
        },
        {
          "slug": "background-hard",
          "color": "#333",
          "name": "Background Hard"
        },
        {
          "slug": "background-inputs",
          "color": "#fff",
          "name": "Inputs Background"
        },
        {
          "slug": "border-inputs",
          "color": "#eee",
          "name": "Inputs Border "
        },
        {
          "slug": "links",
          "color": "#888",
          "name": "Links"
        },
        {
          "slug": "links-light",
          "color": "#eee",
          "name": "Links Light"
        },
        {
          "slug": "buttons",
          "color": "#111",
          "name": "Buttons"
        },
        {
          "slug": "buttons-font",
          "color": "#fff",
          "name": "Buttons Font"
        },
        {
          "slug": "buttons-light",
          "color": "#eee",
          "name": "Buttons light"
        },
        {
          "slug": "buttons-light-font",
          "color": "#111",
          "name": "Buttons light Font"
        }
      ]
    },
    "typography": {
      "customFontSize": true,
      "fluid": true,
      "lineHeight": true,      
      "fontFamilies": [
        {
          "fontFamily": "\"DM Sans\", sans-serif",
          "slug": "dmsans",
          "name": "DM Sans",
          "fontFace": [
            {
              "fontFamily": "DM Sans",
              "fontWeight": "300 900",
              "fontStyle": "normal",
              "fontStretch": "normal",
              "src": [
                "file:./assets/fonts/DMSans-VariableFont_opsz,wght.ttf"
              ]
            }
          ]
        }
      ],
      "fontSizes": [
        {
          "fluid": {
            "max": "15px",
            "min": "12px"
          },
          "name": "Tiny",
          "size": "15px",
          "slug": "tiny"
        },
        {
          "fluid": {
            "max": "18px",
            "min": "16px"
          },
          "name": "Small",
          "size": "18px",
          "slug": "small"
        },
        {
          "fluid": {
            "max": "24px",
            "min": "18px"
          },
          "name": "Normal",
          "size": "24px",
          "slug": "usual"
        },
        {
          "fluid": {
            "max": "36px",
            "min": "28px"
          },
          "name": "Medium",
          "size": "32px",
          "slug": "medium"
        },
        {
          "fluid": {
            "max": "48px",
            "min": "32px"
          },
          "name": "Large",
          "size": "48px",
          "slug": "large"
        },
        {
          "fluid": {
            "max": "64px",
            "min": "36px"
          },
          "name": "Extra large",
          "size": "64px",
          "slug": "extra-large"
        },
        {
          "fluid": {
            "max": "80px",
            "min": "42px"
          },
          "name": "Huge",
          "size": "80px",
          "slug": "xx-large"
        }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--background)",
      "text": "var(--wp--preset--color--primary)"
    },
    "blocks": {
      "core/image": {
        "border": {
          "radius": "var(--wp--preset--spacing--xxs)"
        }
      },
      "core/button": {
        "spacing": {
          "padding": {
          "top": "var(--wp--preset--spacing--xxs)",
          "bottom": "var(--wp--preset--spacing--xxs)"
        }
      },
        "elements": {
          "link": {
            ":hover": {
              "color": {
                "background": "var(--wp--preset--color--buttons)",
                "text": "var(--wp--preset--color--buttons-font)"
              }
            },
            "border": {
              "radius": "var(--wp--preset--spacing--xxs)"
            }
          }
        }
      },
      "core/navigation": {
        "elements": {
          "link": {
            ":hover": {
              "color":  {
                "text": "var(--wp--preset--color--font-text)"
              },
              "border": {
                "style": "none",
                "width": "none"
              }
            },
            "border": {
              "style": "none",
              "width": "none"
            },
            "typography": {
              "fontSize": "var(--wp--preset--font-size--small)",
              "lineHeight": "var(--wp--custom--typography--line-height--normal)"
            }
          }
        }
      },
      "core/details": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--small)",
          "lineHeight": "var(--wp--custom--typography--line-height--normal)"
        }
      },
      "core/list": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--small)",
          "lineHeight": "var(--wp--custom--typography--line-height--normal)"
        }
      },
      "core/site-tagline": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--medium)"
        }
      },
      "core/site-title": {
        "elements": {
          "link": {
            ":hover": {
              "typography": {
                "textDecoration": "none"
              }
            },
            "border": {
              "bottom": {
                "width": "none",
                "style": "none"
              }
            }
          }
        },
        "spacing": {
          "margin": {
            "bottom": "0px",
            "top": "0px"
          }
        }
      },
      "core/post-featured-image": {
        "elements": {
          "link": {
            "border": {
              "bottom": {
                "width": "none",
                "style": "none"
              }
            }
          }
        },
        "border": {
          "radius": "var(--wp--preset--spacing--xxs)"
        }
      },
      "core/post-title": {
        "elements": {
          "link": {
            "border": {
              "bottom": {
                "width": "none",
                "style": "none"
              }
            },
            "color": {
              "text": "var(--wp--preset--color--font-headers)"
            },
            ":hover": {
              "color":  {
                "text": "var(--wp--preset--color--font-text)"
              },
              "border": {
                "style": "none",
                "width": "none"
              }
            }
          }
        }
      },
      "core/post-date": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)"
				}
			},
      "core/post-terms": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)"
				}
			},
      "core/social-links": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)"
				}
			}	
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--dmsans)",
      "fontSize": "var(--wp--preset--font-size--small)",
      "lineHeight": "var(--wp--custom--typography--line-height--normal)"
    },
    "elements": {
      "button": {
        "color": {
          "background": "var(--wp--preset--color--buttons)",
          "text": "var(--wp--preset--color--buttons-font)"
        },
        "typography": {
          "fontSize": "var(--wp--preset--font-size--small)",
          "fontWeight": "600"
        },
        "border": {
          "radius": "var(--wp--preset--spacing--xxs)"
        }
      },
      "caption": {
        "color": {
          "text": "var(--wp--preset--color--font-text)"
        },
        "typography": {
          "fontSize": "var(--wp--preset--font-size--small)"
        }
      },
      "h1": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--large)",
          "lineHeight": "1.25"
        },
        "color": {
          "text": "var(--wp--preset--color--font-headers)"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--medium)",
          "lineHeight": "1.25"
        },
        "color": {
          "text": "var(--wp--preset--color--font-headers)"
        }
      },
      "h3": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--usual)",
          "lineHeight": "1.25"
        }
      },
      "h4": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--small)",
          "lineHeight": "1.25"
        }
      },
      "h5": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--small)",
          "lineHeight": "1.25"
        }
      },
      "h6": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--small)",
          "lineHeight": "1.25"
        }
      },
      "link": {
        ":hover": {
          "border": {
            "bottom": {
              "color": "rgba(255,255,255,0)",
              "width": "1px",
              "style": "solid"
            }
          }
        },
        "color": {
          "text": "var(--wp--preset--color--links)"
        },
        "typography": {
          "textDecoration": "none"
        },
        "border": {
          "bottom": {
            "color": "var(--wp--preset--color--links)",
            "width": "1px",
            "style": "solid"
          }
        }
      }
    },
    "spacing": {
        "padding": {
        "left": "var(--wp--preset--spacing--sm)",
        "right": "var(--wp--preset--spacing--sm)"
      }
    }
  }
}